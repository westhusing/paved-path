{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Base: Renovate's recommended defaults. It auto-detects the managers that
  // apply here — GitHub Actions (the SHA + "# vN" comment pins in .github/),
  // Docker images (the @sha256: digest pins in the workflows and .gitlab/),
  // and Go modules (go.mod).
  "extends": ["config:recommended"],

  // PRs, never auto-merge. Every pin bump (a new trivy digest, a new action
  // SHA) is validated by CI on BOTH platforms before it lands — matching this
  // repo's "verify against upstream, don't guess" ethos. A digest that CI
  // rejects is caught in the PR, not on main.
  "automerge": false,
  "platformAutomerge": false,

  // Run on a schedule rather than continuously: daily is enough for security
  // pin bumps, and it keeps PR noise down on a small repo.
  "schedule": ["after 6am and before 7am on monday, tuesday, wednesday, thursday, friday"],

  // The .gitlab/ templates are the source of truth for GitLab; Renovate edits
  // them in place (they're plain YAML with the same digest pins as GitHub).
  "fileMatch": [
    "\\.github/workflows/.*\\.yml$",
    "\\.gitlab/ci/.*\\.yml$",
    "^go\\.(mod|sum)$"
  ]
}
